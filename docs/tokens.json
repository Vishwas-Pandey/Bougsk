{
  "color": {
    "paper": "#FBF6EE",
    "ink": "#211D1A",
    "charcoal": "#2A2622",
    "charcoalInk": "#FBF6EE",
    "gold": "#C6A15B",
    "goldDeep": "#A9823F",
    "wine": "#6E2A3A",
    "sand": "#E4D8C3",
    "sage": "#5B6C58",
    "white": "#FFFFFF",
    "error": "#B3423A",
    "disabled": "#A09788"
  },
  "font": {
    "display": "Fraunces",
    "body": "Work Sans"
  },
  "type": {
    "display-xl": { "size": 64, "font": "display", "weight": 400 },
    "h1": { "size": 32, "font": "display", "weight": 500 },
    "h3-italic": { "size": 21, "font": "display", "weight": 400, "italic": true },
    "body-lg": { "size": 18, "font": "body", "weight": 400 },
    "body": { "size": 15, "font": "body", "weight": 400 },
    "label-upper": { "size": 12, "font": "body", "weight": 600, "letterSpacing": "0.08em", "textTransform": "uppercase" }
  },
  "radius": {
    "full": "9999px",
    "lg": "24px",
    "md": "12px",
    "sm": "6px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(33, 29, 26, 0.06)",
    "md": "0 4px 16px rgba(33, 29, 26, 0.10)",
    "lg": "0 12px 32px rgba(33, 29, 26, 0.16)"
  },
  "motion": {
    "ease": "cubic-bezier(0.4, 0, 0.2, 1)",
    "durationMs": 300
  }
}
